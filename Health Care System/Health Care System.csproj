    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Health_Care_System</RootNamespace>
    <UserSecretsId>4d4fe89c-9830-4a0c-871f-024c4f3290b4</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
